	(text "GAIN STAGE B\n\nMain gain stage.\n\nRC4558B configured as non-inverting amplifier.\n\nGain controlled by P_GAIN.\n\nPurpose:\nGenerate most of the distortion\nbefore clipping."
		(exclude_from_sim no)
		(at 259.08 173.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "06b69b1e-f49d-42a5-8411-a7c8a60f96ac")
	)
	(text "POWER FILTER\n\n9V supply noise filtering."
		(exclude_from_sim no)
		(at 169.418 86.106 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0ae81602-484f-492f-abba-692abf6fc25e")
	)
	(text "FEEDBACK\n\nSets Gain Stage A gain together with R_STAGE1_REF."
		(exclude_from_sim no)
		(at 111.76 222.504 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0b5334cf-bbb4-4e09-b6bd-93b7c16f97d8")
	)
	(text "ANTI-FIZZ FILTER\n\nR_FIZZ + C_FIZZ.\n\nReduces excessive high-frequency\ncontent generated by clipping.\n\nControls harshness and fizz."
		(exclude_from_sim no)
		(at 304.546 89.154 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "143a9543-be61-4831-9994-5ad082a2f5c5")
	)
	(text "PRE-CLIPPING VOICING\n\nShapes low-frequency content before clipping.\nTypical values: 100nF, 150nF, or 220nF."
		(exclude_from_sim no)
		(at 318.77 210.058 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "24caf871-ccdb-4544-88c6-7fa7cac2c4b5")
	)
	(text "POWER SYSTEM\n\n+9V single supply.\n\nVREF generator creates a virtual ground\nat approximately 4.5V using a resistor divider\nand filtering capacitor.\n\nAll audio stages are biased around VREF\nto allow AC signal amplification from a\nsingle 9V supply."
		(exclude_from_sim no)
		(at 97.536 95.504 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "28dd88fe-178b-4667-93b1-b93b5c71855c")
	)
	(text "RC4558 Power Connections"
		(exclude_from_sim no)
		(at 164.592 231.902 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "335ed2d1-027d-4081-9414-7e6757691189")
	)
	(text "PSEUDO METAL ZONE V1\n\nDual-stage RC4558 distortion pedal using\nsingle-supply (+9V) operation and VREF biasing.\n\nArchitecture:\nInput → Gain Stage A → Interstage Filter →\nGain Stage B → Asymmetrical Clipping →\nAnti-Fizz Filter → Master Volume → Output\n\nThe first stage provides initial amplification.\nThe second stage generates most of the gain.\nAsymmetrical diode clipping creates harmonic distortion.\nThe anti-fizz network reduces excessive high frequencies.\n\nDesigned as a mod-friendly platform with exposed\ntest points and PCB jumpers for experimentation."
		(exclude_from_sim no)
		(at 24.638 40.132 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "445365f9-9145-4816-9dc0-de4cbc73e599")
	)
	(text "DECOUPLING\n\nHigh-frequency supply decoupling.\nPlaced close to RC4558 power pins."
		(exclude_from_sim no)
		(at 165.354 266.192 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5b906653-268f-4123-aee3-34889ac0d62e")
	)
	(text "GAIN STAGE A\n\nFirst amplification stage.\n\nRC4558A configured as non-inverting amplifier.\n\nGain ≈ 22x\n\nPurpose:\nGenerate initial distortion and signal drive."
		(exclude_from_sim no)
		(at 104.14 173.482 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "68d86cb4-5945-419a-95f0-e06ff63e9363")
	)
	(text "ASYMMETRICAL CLIPPING\n\n3x 1N4148 diodes.\n\nOne diode in one direction.\nTwo diodes in series in the opposite direction.\n\nCreates asymmetrical clipping and\nenhances harmonic content."
		(exclude_from_sim no)
		(at 340.36 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8c4f9249-d0f5-4d36-b6d7-e9831e87e079")
	)
	(text "JMP_9V\n\nWire jumper required on PCB V1.\nUsed to route +9V supply to RC4558 pin 8."
		(exclude_from_sim no)
		(at 162.56 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8ce2aa77-fdc2-42db-a733-76db57a52317")
	)
	(text "MASTER VOLUME\n\nControls output level only.\nDoes not affect gain.\n\nOUTPUT COUPLING\n\nBlocks DC before the output jack.\n\nProvides safe audio output signal."
		(exclude_from_sim no)
		(at 368.046 112.014 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a15d9e1a-d7cf-4f90-b1da-4a698f292d8f")
	)
	(text "STAGE1_OUT_PAD\n\nOutput of Gain Stage A (RC4558A pin 1).\nBefore C_INTERSTAGE1."
		(exclude_from_sim no)
		(at 184.404 173.228 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "af45608b-aab0-4d42-a2b9-1caac916c793")
	)
	(text ""
		(exclude_from_sim no)
		(at 389.636 131.318 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bab2187f-316e-4125-8906-55683f550284")
	)
	(text "INTERSTAGE FILTER\n\nControls low-frequency content between stages."
		(exclude_from_sim no)
		(at 209.042 205.486 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bedb336a-7d28-425d-acf9-118e056d28ab")
	)
	(text "INPUT STAGE\n\nC_INPUT_COUPLING:\nBlocks DC and passes guitar signal.\n\nR_INPUT_BIAS:\nProvides high input impedance and\nbiases the signal around VREF."
		(exclude_from_sim no)
		(at 81.534 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "cfa58da4-5fd4-4fdf-87ad-6c6357efd217")
	)
	(text ""
		(exclude_from_sim no)
		(at 191.008 173.228 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d2eeccb2-98fd-4ed3-aeef-e5c88e75fceb")
	)
	(text "JMP_INTER\n\nRoutes Stage A output (RC4558A pin 1)\nto C_INTERSTAGE1, feeding Gain Stage B."
		(exclude_from_sim no)
		(at 155.194 205.994 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e06da155-4187-4483-b1bf-bee5eaad031e")
	)
	(text "MOD PADS\n\nOptional test and modification points.\nProvided for signal probing, circuit analysis,\nand future hardware modifications.\n\n- 9V_PAD: +9V supply rail.\n\n- GND_PAD1, GND_PAD2: Ground reference points.\n\n- VREF_PAD1, VREF_PAD2: Virtual ground reference (~4.5V).\n\n- STAGE1_OUT_PAD: Output of Gain Stage A. RC4558A pin 1.\n\n- STAGE2_IN_PAD: Input of Gain Stage B. After C_INTERSTAGE1 and before RC4558B pin 5.\n\n- CLIP_NODE_PAD: Clipping node. After C_CLIP_IN1 and before clipping diodes.\n\n- OUTPUT_PAD: Final audio output. After C_OUTPUT_COUPLING1 and before output jack.\n\nNot required for normal operation."
		(exclude_from_sim no)
		(at 22.606 252.222 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "ea160ee0-3b96-463f-9a64-6cca38660152")
	)
	(text "GAIN LIMIT\n\nLimits maximum stage gain.\nHelps prevent excessive op-amp saturation."
		(exclude_from_sim no)
		(at 268.478 263.906 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f9d3a6ef-a3b7-4afb-a5d4-a970653e8954")
	)
